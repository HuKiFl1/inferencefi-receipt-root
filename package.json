{
  "name": "inferencefi-receipt-root",
  "version": "0.1.0",
  "description": "Inference Finance IF-D8 consumer layer on xbtMelchizedek's flop-receipt-root v0.3.2: TypeScript reference of the receipt-root format, hook/rewards/minter consumer models, Solidity reference consumers, and shared test vectors.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "DESIGN.md",
    "README.md",
    "vectors",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "vectors": "tsx scripts/gen-vectors.ts",
    "forge": "npm run forge:consumers && npm run forge:upstream",
    "check": "npm run typecheck && npm test && npm run forge",
    "forge:consumers": "cd foundry && forge test",
    "forge:upstream": "cd vendor/flop-receipt-root && forge test"
  },
  "keywords": [
    "merkle",
    "receipt-root",
    "eip-712",
    "payment-channel",
    "nullifier",
    "inference",
    "bigint"
  ],
  "devDependencies": {
    "@noble/hashes": "^2.4.0",
    "@types/node": "^20.19.43",
    "fast-check": "^4.11.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
